<aura:component implements="force:hasRecordId,lightning:availableForFlowScreens" access="global">
    <aura:attribute name="objectName" type="String"/>
    <aura:attribute name="layout" type="String" default="Full"/>
    <aura:attribute name="mode" type="String" default="edit"/>
    <lightning:recordForm
        recordId="{!v.recordId}"
        objectApiName="{!v.objectName}"
        layoutType="{!v.layout}"
        mode="{!v.mode}" />
</aura:component>