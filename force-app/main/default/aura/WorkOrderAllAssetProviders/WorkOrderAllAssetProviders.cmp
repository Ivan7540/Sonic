<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId,lightning:availableForFlowScreens,lightning:availableForFlowActions" access="global">
    <aura:attribute name="workOrder" type="Object"/>
    <aura:attribute name="recordLoadError" type="String"/>
    
    <force:recordData aura:id="recordLoader"
        fields="Id, Order__c, Account__c"
        recordId="{!v.recordId}"
        targetFields="{!v.workOrder}"
        targetError="{!v.recordLoadError}"
    />
    <aura:if isTrue="{!not(empty(v.workOrder.Account__c))}">
        <sortablegrid:sdg Title="All Asset Providers" SVGName="standard:asset" SDGConfiguration="CustomObject:AccountAssetProviders"
                          HideOnError="true" ShowDebug="false" UseCache="false" 
                          PreventResponsiveness="true" DefaultPageSize="10"
                          recordId="{!v.workOrder.Account__c}"/>
    </aura:if>
	{!v.recordLoadError}
</aura:component>