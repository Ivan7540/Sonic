<aura:component implements="lightning:availableForFlowScreens,lightning:availableForFlowActions,force:hasRecordId,force:hasSObjectName"
                controller="LCC_QuoteSummary">
    <aura:attribute name="quoteLinesGroup" type="List"/>
    <aura:attribute name="rates" type="List"/>
    <aura:attribute name="tableColumns"	type="List"/>
    <aura:attribute name="ratesColumns" type="List"/>
    <aura:attribute name="monthlyAmount" type="Decimal"/>
    <aura:attribute name="onceOffAmount" type="Decimal"/>
    <aura:attribute name="transactionMargin" type="Decimal"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <lightning:card iconName="standard:product_item" title="Rates" >
        <lightning:datatable aura:id="rateTable"
                             keyField="quoteLineId"
                             data="{!v.rates}"
                             columns="{!v.ratesColumns}"
                             hideCheckboxColumn="true"/>
    </lightning:card>
    <aura:iteration items="{!v.quoteLinesGroup}" var="group">
        <lightning:card iconName="standard:product_item" title="{!group.groupName}" >
            <lightning:datatable aura:id="productTable"
                                 keyField="quoteLineId"
                                 data="{!group.quoteLines}"
                                 columns="{!v.tableColumns}"
                                 class="slds-scrollable--x"
                                 minColumnWidth="100"
                                 hideCheckboxColumn="true"/>
        </lightning:card>
    </aura:iteration>   
    <div class="slds-box slds-theme_shade">
        <lightning:layout>
            <lightning:layoutItem size="6">
                <div class="slds-text-color_default">Once-Off Cost: R {!v.onceOffAmount}</div>
            </lightning:layoutItem>
            <lightning:layoutItem size="6">
                <div class="slds-text-color_default">Monthly cost: R {!v.monthlyAmount}</div>
            </lightning:layoutItem>
        </lightning:layout>
    </div>
    <div class="slds-box slds-theme_shade">
        <lightning:layout>
            <lightning:layoutItem size="6">
                <div class="slds-text-color_default">Transaction Margin:</div>
            </lightning:layoutItem>
            <lightning:layoutItem size="6">
                <div class="slds-text-color_default">R {!v.transactionMargin}</div>
            </lightning:layoutItem>
        </lightning:layout>
    </div> 
</aura:component>