<aura:component controller="StockViewController" implements="force:hasRecordId,flexipage:availableForRecordHome,lightning:availableForFlowScreens" access="global">
    <aura:attribute name="workOrder" type="Object"/>    
    <aura:attribute name="columns" type="List" />
    <aura:attribute name="recordLoadError" type="String"/>
    <aura:attribute name="stockList" type="Object" />
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>

    <force:recordData aura:id="recordLoader"
        fields="Id, Account__c"
        recordId="{!v.recordId}"
        targetFields="{!v.workOrder}"
        targetError="{!v.recordLoadError}"
        recordUpdated="{!c.recordUpdate}"
    />

    <lightning:card iconName="custom:custom28" title="Merchant Stock">
        <lightning:datatable data="{!v.stockList}"
            columns="{!v.columns}"
            keyField="Id"
            hideCheckboxColumn="true"
            aura:id="stockTable"
        />
    </lightning:card>

</aura:component>