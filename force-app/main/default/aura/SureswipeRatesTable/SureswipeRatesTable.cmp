<aura:component implements="force:lightningQuickAction,flexipage:availableForAllPageTypes,lightning:availableForFlowScreens,lightning:availableForFlowActions,force:hasRecordId,force:hasSObjectName"
                controller="LCC_SureswipeRatesTableController">
    
    <aura:attribute name="ratesList" type="List"/>
    <aura:attribute name="ratesColumns" type="List"/>
    <aura:attribute name="title" type="String"/>
    
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    
    <lightning:card iconName="standard:product_item" title="{!v.title}">
        <lightning:datatable aura:id="rateTable"
                             keyField="quoteLineId"
                             data="{!v.ratesList}"
                             columns="{!v.ratesColumns}"
                             hideCheckboxColumn="true"/>
    </lightning:card>
    
</aura:component>