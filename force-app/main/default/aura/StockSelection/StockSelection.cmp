<aura:component controller="StockSelectionController" implements="force:lightningQuickAction,force:hasRecordId">
    <aura:attribute name="order" type="Object"/>
    <aura:attribute name="stockList" type="Object" />
    <aura:attribute name="columns" type="List" />
    <aura:attribute name="recordLoadError" type="String"/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <force:recordData aura:id="recordLoader"
        fields="OriginatingWarehouse__c"
        recordId="{!v.recordId}"
        targetFields="{!v.order}"
        targetError="{!v.recordLoadError}"
        recordUpdated="{!c.recordUpdate}"
    />
    <lightning:datatable data="{! v.stockList }"
        columns="{! v.columns }"
        keyField="Id"
        hideCheckboxColumn="false"
        aura:id="stockTable"
    />
    <br/>
    <div class="slds-align_absolute-center">
        <lightning:button label="Add Stock to Order" variant="brand" onclick="{!c.addStock}"/>
    </div>    
</aura:component>