<aura:component controller="AssetSelectionController" implements="lightning:availableForFlowScreens,force:hasRecordId">
    <aura:attribute name="workOrder" type="Object"/>
    <aura:attribute name="assetList" type="Object" />
    <aura:attribute name="columns" type="List" />
    <aura:attribute name="recordLoadError" type="String"/>
    <aura:attribute name="wolisCreated" type="Boolean" default="false"/>
    <aura:attribute name="validate" type="Aura.Action" description="Custom validation function to run when the flow is navigated to the next screen. The function must evaluate the component and return values for isValid and errorMessage."/>
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <force:recordData aura:id="recordLoader"
        fields="Account__c"
        recordId="{!v.recordId}"
        targetFields="{!v.workOrder}"
        targetError="{!v.recordLoadError}"
        recordUpdated="{!c.recordUpdate}"
    />
    <lightning:datatable data="{! v.assetList }"
        columns="{! v.columns }"
        keyField="Id"
        hideCheckboxColumn="false"
        aura:id="assetTable"
    />
    <br/>
    <div class="slds-align_absolute-center">
        <lightning:button label="Create Work Order Lines" variant="brand" onclick="{!c.createWorkLines}"/>
    </div>    
</aura:component>