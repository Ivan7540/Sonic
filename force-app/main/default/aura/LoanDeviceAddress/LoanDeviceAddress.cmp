<aura:component implements="flexipage:availableForRecordHome,force:hasRecordId">
    <aura:attribute name="workOrder" type="Object"/>
    <aura:attribute name="recordLoadError" type="String"/>
    <aura:attribute name="accountFields" type="String[]" default="['Name', 'Industry', 'Business_Hours_From__c', 'Business_Hours_To__c',
        'ReceiptFooter__c', 'ReceiptHeader__c']"/>
    <aura:attribute name="quoteFields" type="String[]" default="['SBQQ__ShippingStreet__c', 'SBQQ__ShippingState__c',
        'SBQQ__ShippingPostalCode__c', 'SBQQ__ShippingName__c', 'SBQQ__ShippingCountry__c', 'SBQQ__ShippingCity__c']"/>

    <force:recordData 
        aura:id="recordLoader"
        fields="Account__r.Name, Account__r.Industry, Account__r.Business_Hours_From__c, Account__r.Business_Hours_To__c,
            Account__r.ReceiptFooter__c, Account__r.ReceiptHeader__c, Order__r.SBQQ__Quote__r.SBQQ__ShippingStreet__c, 
            Order__r.SBQQ__Quote__r.SBQQ__ShippingState__c, Order__r.SBQQ__Quote__r.SBQQ__ShippingPostalCode__c, 
            Order__r.SBQQ__Quote__r.SBQQ__ShippingName__c, Order__r.SBQQ__Quote__r.SBQQ__ShippingCountry__c, 
            Order__r.SBQQ__Quote__r.SBQQ__ShippingCity__c, Account__c, Order__r.SBQQ__Quote__c" 
        recordId="{!v.recordId}"
        targetFields="{!v.workOrder}"
        targetError="{!v.recordLoadError}"
    />

    <lightning:card iconName="standard:account" title="Account Details">
        <lightning:recordForm 
            recordId="{!v.workOrder.Account__c}"
            columns="2"
            objectApiName="Account"
            fields="{!v.accountFields}"
            mode="view"
        />
        <lightning:recordForm
            recordId="{!v.workOrder.Order__r.SBQQ__Quote__c}"
            columns="2"
            objectApiName="SBQQ__Quote__c"
            fields="{!v.quoteFields}"
            mode="view"
        />
    </lightning:card>
</aura:component>