<aura:component controller="BillingListController" implements="flexipage:availableForRecordHome,force:hasRecordId">
    <aura:handler name="init" value="{!this}" action="{!c.doInit}"/>
    <aura:attribute name="contractRecord" type="Object"/>
    <aura:attribute name="recordLoadError" type="String"/>
    <aura:attribute name="subscriptionColumns" type="List" />
    <aura:attribute name="rateColumns" type="List" />
    <aura:attribute name="subscriptionList" type="Object" />
    <aura:attribute name="subscriptionHide" type="Boolean" default="true" />
    <aura:attribute name="rateHide" type="Boolean" default="true" />
    <force:recordData aura:id="recordLoader"
        fields="AccountId, RateContract__c"
        recordId="{!v.recordId}"
        targetFields="{!v.contractRecord}"
        targetError="{!v.recordLoadError}"
        recordUpdated="{!c.recordUpdate}"
    />
    <lightning:datatable 
        data="{! v.subscriptionList }"
        columns="{! v.subscriptionColumns }"
        keyField="Id"
        hideCheckboxColumn="true"
        class="{!v.subscriptionHide ? 'slds-hide last-row-bold' : 'last-row-bold'}"
    />
    <lightning:datatable 
        data="{! v.subscriptionList }"
        columns="{! v.rateColumns }"
        keyField="Id"
        hideCheckboxColumn="true"
        class="{!v.rateHide ? 'slds-hide' : ''}"
    />
</aura:component>