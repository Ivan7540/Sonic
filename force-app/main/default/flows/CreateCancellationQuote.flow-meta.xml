    <formulas>
        <name>cancellationFees</name>
        <dataType>Currency</dataType>
        <expression>{!cancellationTotal} * {!fmlPositiveContractTerm}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fmlLineNetTotal</name>
        <dataType>Number</dataType>
        <expression>{!LoopQuoteLines.SBQQ__NetPrice__c} * {!LoopQuoteLines.SBQQ__Quantity__c}</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>fmlPositiveContractTerm</name>
        <dataType>Number</dataType>
        <expression>if({!GetContract.Term_Remaining__c} &gt; 0, {!GetContract.Term_Remaining__c}, 0)</expression>
        <scale>2</scale>
    </formulas>
