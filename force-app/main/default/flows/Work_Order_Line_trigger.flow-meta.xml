    <decisions>
        <description>Determines if the Line Item has an Asset or Stock referenced, and sets field values accordingly</description>
        <name>Has_Asset</name>
        <label>Has Asset/Stock</label>
        <locationX>446</locationX>
        <locationY>647</locationY>
        <defaultConnectorLabel>Neither</defaultConnectorLabel>
        <rules>
            <name>Asset</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Asset__c</leftValueReference>
