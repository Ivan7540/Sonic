        <connector>
            <targetReference>Does_Contact_Exist</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>Merchant_Number_Input</elementReference>
            </value>
        </filters>
        <object>MerchantId__c</object>
        <outputAssignments>
            <assignToReference>CompanyID</assignToReference>
            <field>Account__c</field>
        </outputAssignments>
        <outputAssignments>
            <assignToReference>MerchantNumberVar</assignToReference>
            <field>Name</field>
        </outputAssignments>
    </recordLookups>
