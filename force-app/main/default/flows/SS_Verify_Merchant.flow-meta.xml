    <decisions>
        <name>Does_Contact_Exist</name>
        <label>Does Contact Exist</label>
        <locationX>361</locationX>
        <locationY>749</locationY>
        <defaultConnector>
            <targetReference>Assign_Stage_2</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>[Default Outcome]</defaultConnectorLabel>
        <rules>
            <name>Merchant_Number_is_null</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>MerchantNumberVar</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <elementReference>Merchant_Number_Input</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Name_Not_Found_Screen</targetReference>
            </connector>
            <label>Merchant Number is null</label>
        </rules>
    </decisions>
    <description>This flow is used to verify a merchant call into the call centre</description>
    <formulas>
        <name>User_Formula</name>
        <dataType>String</dataType>
        <expression>{!$User.FirstName}</expression>
    </formulas>
    <interviewLabel>SS_Verify Merchant {!$Flow.CurrentDateTime}</interviewLabel>
    <label>SS_Verify Merchant</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
