        <rules>
            <name>Is_Classic</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>PrepareDealProductVariable.Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Classic</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PrepareDealProductVariable.Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ClassicPlus</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>PrepareDealProductVariable.Product__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>ClassicPlusWithPOS</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Assign_is_Classic</targetReference>
            </connector>
            <label>Is Classic</label>
        </rules>
    </decisions>
