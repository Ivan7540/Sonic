        <rules>
            <name>Do_not_have_Rates</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>deal_lines</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Is_Classic</leftValueReference>
                <operator>EqualTo</operator>
