            </connector>
            <label>Do not have Rates</label>
        </rules>
    </decisions>
    <decisions>
        <name>Is_Classic_or_Classic_Plus</name>
        <label>Is Classic or Classic Plus</label>
        <locationX>677</locationX>
        <locationY>488</locationY>
        <defaultConnector>
