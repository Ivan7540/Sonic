    <decisions>
        <name>Need_Approval</name>
        <label>Need Approval?</label>
        <locationX>1367</locationX>
        <locationY>626</locationY>
        <defaultConnector>
            <targetReference>add_deal_lines</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Credit_or_Debit_out_of_bounds</name>
            <conditionLogic>(1 AND 2) OR (3 AND 4)</conditionLogic>
            <conditions>
                <leftValueReference>Loop_deal_Lines.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>credit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_deal_Lines.Rate_Percentage__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>1.85</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_deal_Lines.Name</leftValueReference>
                <operator>Contains</operator>
                <rightValue>
                    <stringValue>debit</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Loop_deal_Lines.Rate_Percentage__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>0.85</numberValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Mark_as_need_approval</targetReference>
            </connector>
            <label>Credit or Debit out of bounds</label>
        </rules>
    </decisions>
