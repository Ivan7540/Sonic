    <decisions>
        <description>Decides which Record Type to use for the Work Order based on the estimated amount of swipe per month, type of sale and Products being sold</description>
        <name>Swipe_Value</name>
        <label>Swipe Value</label>
        <locationX>182</locationX>
        <locationY>518</locationY>
        <defaultConnector>
            <targetReference>High_Touch</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>&gt; 40000</defaultConnectorLabel>
        <rules>
            <name>X40000</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Account.Monthly_Swipe_Value_Card_Value__c</leftValueReference>
                <operator>LessThan</operator>
                <rightValue>
                    <numberValue>40000.0</numberValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Order.SaleType__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Outright Purchase</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>SME_Order_Product</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Low_Touch</targetReference>
            </connector>
            <label>&lt; 40000</label>
        </rules>
    </decisions>
