<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>51.0</apiVersion>
    <assignments>
        <description>Adds the newly created Work Order Action record to a collection</description>
        <name>Add_record_to_collection</name>
        <label>Add record to collection</label>
        <locationX>264</locationX>
        <locationY>815</locationY>
        <assignmentItems>
            <assignToReference>NewActions</assignToReference>
            <operator>Add</operator>
            <value>
                <elementReference>NewAction</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>For_each_template</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Creates the Work Order Action Record</description>
        <name>Create_Action_record</name>
        <label>Create Action record</label>
        <locationX>264</locationX>
        <locationY>695</locationY>
        <assignmentItems>
            <assignToReference>NewAction.WorkOrder__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Record.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewAction.CompletionAction__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_each_template.CompletionAction__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewAction.NewStatus__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_each_template.NewStatus__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewAction.MetadataReference__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_each_template.Id</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewAction.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_each_template.Label</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewAction.HoursDue__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_each_template.TimeDue__c</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>NewAction.OrdinalNumber__c</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>For_each_template.OrdinalNumber__c</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>Add_record_to_collection</targetReference>
        </connector>
    </assignments>
    <description>The flow handling post-insert of the Work Order record</description>
    <interviewLabel>Work Order Create Trigger {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Work Order Create Trigger</label>
    <loops>
        <description>Loops through Action Template records</description>
        <name>For_each_template</name>
        <label>For each template</label>
        <locationX>176</locationX>
        <locationY>575</locationY>
        <collectionReference>Get_metadata_templates</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>Create_Action_record</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>Insert_Action_records</targetReference>
        </noMoreValuesConnector>
    </loops>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>OriginBuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Inserts the Work Order Actions from the loop</description>
        <name>Insert_Action_records</name>
        <label>Insert Action records</label>
        <locationX>176</locationX>
        <locationY>1031</locationY>
        <inputReference>NewActions</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Get the &apos;umbrella&apos; metadata record for the status (expected to only be &apos;New&apos;)</description>
        <name>Get_Metadata_record_0_0_0_0_0_0</name>
        <label>Get Metadata record</label>
        <locationX>176</locationX>
        <locationY>335</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>Get_metadata_templates</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Work_Order_Record_Type__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.RecordType.DeveloperName</elementReference>
            </value>
        </filters>
        <filters>
            <field>Work_Order_Status__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Status__c</elementReference>
            </value>
        </filters>
        <filters>
            <field>WorkOrderType__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>$Record.Type__c</elementReference>
            </value>
        </filters>
        <object>WorkOrderStage__mdt</object>
        <outputReference>StageRecord</outputReference>
        <queriedFields>Id</queriedFields>
        <queriedFields>Product__c</queriedFields>
        <queriedFields>DeveloperName</queriedFields>
        <queriedFields>Work_Order_Record_Type__c</queriedFields>
        <queriedFields>Work_Order_Status__c</queriedFields>
        <queriedFields>WorkOrderType__c</queriedFields>
        <queriedFields>MasterLabel</queriedFields>
    </recordLookups>
    <recordLookups>
        <description>The templates for creating the Work Order Action records for the current stage of the Work Order</description>
        <name>Get_metadata_templates</name>
        <label>Get metadata templates</label>
        <locationX>176</locationX>
        <locationY>455</locationY>
        <assignNullValuesIfNoRecordsFound>false</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>For_each_template</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Conditions__c</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>StageRecord.Id</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>false</getFirstRecordOnly>
        <object>ActionTemplate__mdt</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <start>
        <locationX>50</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>Get_Metadata_record_0_0_0_0_0_0</targetReference>
