        <object>Stock__c</object>
        <storeOutputAutomatically>true</storeOutputAutomatically>
    </recordLookups>
    <recordUpdates>
        <name>Commit_Line_Item</name>
        <label>Commit Line Item</label>
        <locationX>50</locationX>
