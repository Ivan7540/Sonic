    <recordUpdates>
        <description>Sets the selected replacement Stock on the Asset</description>
        <name>Update_Asset</name>
        <label>Update Asset</label>
        <locationX>50</locationX>
        <locationY>1598</locationY>
        <connector>
            <targetReference>Update_Line_Item</targetReference>
        </connector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Id</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>LineItem.Asset__c</elementReference>
            </value>
        </filters>
        <inputAssignments>
            <field>AssignedStock__c</field>
            <value>
                <elementReference>Get_New_Stock.Id</elementReference>
            </value>
        </inputAssignments>
        <object>Asset</object>
    </recordUpdates>
