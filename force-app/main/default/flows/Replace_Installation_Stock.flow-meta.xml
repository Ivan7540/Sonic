    <decisions>
        <description>Determines if the Work Order Line Item has been found. If not, this usually means that the flow was configured for a different object than was intended.</description>
        <name>Found</name>
        <label>Line Item Found</label>
        <locationX>1114</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>ObjectError</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Found</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LineItem</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Has_Asset</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines if the Line Item in question has an Asset</description>
        <name>Has_Asset</name>
        <label>Has Asset</label>
        <locationX>858</locationX>
        <locationY>398</locationY>
        <defaultConnector>
            <targetReference>AssetError</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Asset</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LineItem.Asset__c</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Serial_Selection</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks whether the Product of the Stock matches that of the Asset</description>
        <name>Product_Correct</name>
        <label>Product Correct</label>
        <locationX>182</locationX>
        <locationY>998</locationY>
        <defaultConnector>
            <targetReference>ProductError</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Product</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>LineItem.Asset__r.Product2Id</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <elementReference>Get_New_Stock.Product__c</elementReference>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Old_Stock</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Checks that Stock is in a valid status</description>
        <name>Status_Correct</name>
        <label>Status Correct</label>
        <locationX>380</locationX>
        <locationY>878</locationY>
        <defaultConnector>
            <targetReference>StatusError</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Status</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_New_Stock.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>In Stock</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_New_Stock.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Boot stock</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Product_Correct</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <decisions>
        <description>Determines if the Stock with the serial number that the user entered actually exist</description>
        <name>Stock_Found</name>
        <label>Stock Found</label>
        <locationX>611</locationX>
        <locationY>758</locationY>
        <defaultConnector>
            <targetReference>Serial_Error</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes_Serial</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>Get_New_Stock</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Status_Correct</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
    </decisions>
    <description>Allows the fulfilment to replace Stock issued for installation that proves defective when the technician attempts to install it</description>
