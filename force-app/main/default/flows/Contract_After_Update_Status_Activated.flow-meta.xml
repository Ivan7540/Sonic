    <description>Now updates only when contract is set to Activated</description>
    <formulas>
        <name>newRateContractTerm</name>
        <dataType>Number</dataType>
        <expression>{!$Record.RateContract__r.ContractTerm} + ({!rateContractDeviceContractMonthDifference} * -1)</expression>
        <scale>2</scale>
    </formulas>
    <formulas>
        <name>rateContractDeviceContractMonthDifference</name>
        <dataType>Number</dataType>
        <expression>(Year({!$Record.RateContract__r.EndDate}) - Year({!$Record.EndDate}))*12 + (Month({!$Record.RateContract__r.EndDate}) - Month({!$Record.EndDate}))</expression>
        <scale>2</scale>
    </formulas>
