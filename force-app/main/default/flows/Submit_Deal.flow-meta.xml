    <decisions>
        <description>If deal is on Quote Approved, show warning message.</description>
        <name>Check_Deal_Status</name>
        <label>Check Deal Status</label>
        <locationX>182</locationX>
        <locationY>278</locationY>
        <defaultConnector>
            <targetReference>Submit_Deal</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Default Outcome</defaultConnectorLabel>
        <rules>
            <name>Deal_is_Quote_Approved</name>
            <conditionLogic>or</conditionLogic>
            <conditions>
                <leftValueReference>Get_Deal_for_Status.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Quote Approved</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>Get_Deal_for_Status.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Sent To Client</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Document_Warning</targetReference>
            </connector>
            <label>Deal is Quote Approved</label>
        </rules>
    </decisions>
