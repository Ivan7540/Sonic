    <decisions>
        <description>Determines if the Deal should initiate a creation of users on Clientzone in order for FICA documents to be uploaded. Currently true for Deals coming from the digital sales channel.</description>
        <name>Create_Clientzone_User</name>
        <label>Create Clientzone User</label>
        <locationX>259</locationX>
        <locationY>334</locationY>
        <defaultConnectorLabel>No</defaultConnectorLabel>
        <rules>
            <name>Yes</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Channel__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Digital</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Document Gathering</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sale_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Outright Purchase</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.DocumentCheck__c</leftValueReference>
                <operator>NotEqualTo</operator>
                <rightValue>
                    <stringValue>FICA Rejected</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_CZ_User</targetReference>
            </connector>
            <label>Yes</label>
        </rules>
        <rules>
            <name>Is_Digital_sales_Rental</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>$Record.Channel__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Digital</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Status__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Client Signed</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>$Record.Sale_Type__c</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Rental</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>Create_User_on_Clientzone_for_Digital_Sales_Rental</targetReference>
            </connector>
            <label>Is Digital sales Rental</label>
        </rules>
    </decisions>
