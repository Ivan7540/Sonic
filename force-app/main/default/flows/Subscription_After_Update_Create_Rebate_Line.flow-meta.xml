    <description>SWW:2021-04-15:: Now checks if subscription line is not a revised line</description>
    <formulas>
        <name>fmlEndDate</name>
        <dataType>Date</dataType>
        <expression>DATE(
YEAR({!$Record.SBQQ__StartDate__c}),
MONTH({!$Record.SBQQ__StartDate__c})  + 3,
DAY({!$Record.SBQQ__StartDate__c})
)</expression>
