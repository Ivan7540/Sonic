<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>false</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>Owner</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>false</allowDelegate>
        <approvalActions>
            <action>
                <name>ITC_Override_Approval_Approved</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Opportunity_ITC_Approved</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Opportunity_Risk_Submitted</name>
                <type>FieldUpdate</type>
            </action>
            <action>
                <name>Risk_Approval_Assignment_Alert</name>
                <type>Alert</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>janinelouw@sureswipe.co.za.sonic</name>
                <type>user</type>
            </approver>
            <approver>
                <name>phumudzo@sureswipe.co.za.sonic</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <label>ITC Override Approval</label>
        <name>Step_1</name>
        <rejectionActions>
            <action>
                <name>ITC_Override_Approval_Rejected</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Opportunity_ITC_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <approvalActions>
            <action>
                <name>Risk_Approval_Approved_Alert</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Update_Opportunity_To_Risk_Approved</name>
                <type>FieldUpdate</type>
            </action>
        </approvalActions>
        <assignedApprover>
            <approver>
                <name>janinelouw@sureswipe.co.za.sonic</name>
                <type>user</type>
            </approver>
            <approver>
                <name>phumudzo@sureswipe.co.za.sonic</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>Opportunity.DocumentCheckStatus__c</field>
                <operation>equals</operation>
                <value>ITC Approved</value>
            </criteriaItems>
        </entryCriteria>
        <label>Risk Approval</label>
        <name>Risk_Approval</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
        <rejectionActions>
            <action>
                <name>Risk_Approval_Rejected_Alert</name>
                <type>Alert</type>
            </action>
            <action>
                <name>Set_Opportunity_to_Risk_Rejected</name>
                <type>FieldUpdate</type>
            </action>
        </rejectionActions>
    </approvalStep>
    <emailTemplate>Opportunity_Approval_Templates/ITC_Override_Approval_Assignment</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <entryCriteria>
        <criteriaItems>
            <field>Opportunity.DocumentCheckStatus__c</field>
            <operation>equals</operation>
            <value>ITC Rejected</value>
        </criteriaItems>
    </entryCriteria>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <label>ITC Override &amp; Risk Approval Assignment</label>
    <nextAutomatedApprover>
        <useApproverFieldOfRecordOwner>false</useApproverFieldOfRecordOwner>
        <userHierarchyField>Manager</userHierarchyField>
    </nextAutomatedApprover>
    <processOrder>1</processOrder>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
