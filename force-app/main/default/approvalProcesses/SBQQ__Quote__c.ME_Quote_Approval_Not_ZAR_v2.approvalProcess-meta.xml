<?xml version="1.0" encoding="UTF-8"?>
<ApprovalProcess xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <allowRecall>true</allowRecall>
    <allowedSubmitters>
        <type>owner</type>
    </allowedSubmitters>
    <approvalPageFields>
        <field>Name</field>
        <field>AccountName__c</field>
        <field>Owner</field>
        <field>SBQQ__CustomerDiscount__c</field>
        <field>SBQQ__AverageCustomerDiscount__c</field>
        <field>SBQQ__NetAmount__c</field>
        <field>NetAmountWithVAT__c</field>
        <field>OnceOff_Price__c</field>
        <field>Monthly_Price__c</field>
        <field>VATPercent__c</field>
    </approvalPageFields>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>daphne@innervationgroup.com.sonic</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>SBQQ__Quote__c.CurrencyIsoCode</field>
                <operation>notEqual</operation>
                <value>ZAR</value>
            </criteriaItems>
            <criteriaItems>
                <field>SBQQ__Quote__c.Owner_Name__c</field>
                <operation>equals</operation>
                <value>Vincent Kannemeyer</value>
            </criteriaItems>
        </entryCriteria>
        <ifCriteriaNotMet>GotoNextStep</ifCriteriaNotMet>
        <label>Quote Approval Vincent</label>
        <name>Other_Currency_Vincent</name>
    </approvalStep>
    <approvalStep>
        <allowDelegate>true</allowDelegate>
        <assignedApprover>
            <approver>
                <name>vincentk@innervationgroup.com.sonic</name>
                <type>user</type>
            </approver>
            <whenMultipleApprovers>FirstResponse</whenMultipleApprovers>
        </assignedApprover>
        <entryCriteria>
            <criteriaItems>
                <field>SBQQ__Quote__c.CurrencyIsoCode</field>
                <operation>notEqual</operation>
                <value>ZAR</value>
            </criteriaItems>
            <criteriaItems>
                <field>SBQQ__Quote__c.Owner_Name__c</field>
                <operation>equals</operation>
                <value>Daphne Feris</value>
            </criteriaItems>
        </entryCriteria>
        <label>Quote Approval Daphne</label>
        <name>Quote_Approval_Not_ZAR_Daphne</name>
        <rejectBehavior>
            <type>RejectRequest</type>
        </rejectBehavior>
    </approvalStep>
    <emailTemplate>Quote_Email_Templates/Quote_Sent_for_Approval</emailTemplate>
    <enableMobileDeviceAccess>false</enableMobileDeviceAccess>
    <finalApprovalActions>
        <action>
            <name>Quote_Approval_Approved</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Sent_for_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </finalApprovalActions>
    <finalApprovalRecordLock>false</finalApprovalRecordLock>
    <finalRejectionActions>
        <action>
            <name>Quote_Rejected</name>
            <type>Alert</type>
        </action>
        <action>
            <name>Reject</name>
            <type>FieldUpdate</type>
        </action>
    </finalRejectionActions>
    <finalRejectionRecordLock>false</finalRejectionRecordLock>
    <initialSubmissionActions>
        <action>
            <name>Set_Awaiting_Approval</name>
            <type>FieldUpdate</type>
        </action>
    </initialSubmissionActions>
    <label>ME Quote Approval Not ZAR</label>
    <processOrder>6</processOrder>
    <recallActions>
        <action>
            <name>New</name>
            <type>FieldUpdate</type>
        </action>
    </recallActions>
    <recordEditability>AdminOnly</recordEditability>
    <showApprovalHistory>true</showApprovalHistory>
</ApprovalProcess>
