<?xml version="1.0" encoding="UTF-8"?>
<AssignmentRules xmlns="http://soap.sforce.com/2006/04/metadata">
    <assignmentRule>
        <fullName>Case Assignments</fullName>
        <active>true</active>
        <ruleEntry>
            <assignedTo>SS_CC_Priority_Support</assignedTo>
            <assignedToType>Queue</assignedToType>
            <booleanFilter>(1 OR 4) AND 2 AND 3</booleanFilter>
            <criteriaItems>
                <field>Account.Service_Level__c</field>
                <operation>equals</operation>
                <value>Platinum Support</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.OwnerId</field>
                <operation>equals</operation>
                <value>SS_Call Centre</value>
            </criteriaItems>
            <criteriaItems>
                <field>Case.RecordTypeId</field>
                <operation>equals</operation>
                <value>Customer Enquiry</value>
            </criteriaItems>
            <criteriaItems>
                <field>Account.Service_Level__c</field>
                <operation>equals</operation>
                <value>Gold Support</value>
            </criteriaItems>
        </ruleEntry>
    </assignmentRule>
</AssignmentRules>
