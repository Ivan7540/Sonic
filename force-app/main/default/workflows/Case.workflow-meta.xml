    <rules>
        <fullName>Sonic Support Case Creation</fullName>
        <actions>
            <name>Sonic_Support_Case_Creation</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.RecordTypeId</field>
            <operation>equals</operation>
            <value>CX Support</value>
        </criteriaItems>
        <triggerType>onCreateOnly</triggerType>
    </rules>
    <rules>
        <fullName>Unpaid Case Creation Notification</fullName>
        <actions>
            <name>Notify_Account_Manager_Of_Unpaid_Debit_Order</name>
            <type>Alert</type>
        </actions>
        <actions>
            <name>Notify_Merchant_that_they_have_an_unpaid_debit_order_amount</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.RecordTypeId</field>
            <operation>equals</operation>
            <value>Unpaid Debit Order</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>New</value>
        </criteriaItems>
        <description>Notify the Account Manager and Merchant of Unpaid Debit order</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Unpaid Debit%3A Unsuspend%2FPayment Made</fullName>
        <actions>
            <name>Notification_to_Fufilment_Team_for_Unpaid_Debit</name>
            <type>Alert</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.RecordTypeId</field>
            <operation>equals</operation>
            <value>Unpaid Debit Order</value>
        </criteriaItems>
        <criteriaItems>
            <field>Case.Status</field>
            <operation>equals</operation>
            <value>Unsuspend Terminal,Payment Made</value>
        </criteriaItems>
        <description>A new notification needs to be triggered when the status on the unpaid debit order case is changed to “unpaid debit – unsuspend terminal “and “unpaid debit – payment made “</description>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
    <rules>
        <fullName>Update Account Manager Email</fullName>
        <actions>
            <name>Update_AM_Email_Address</name>
            <type>FieldUpdate</type>
        </actions>
        <active>true</active>
        <criteriaItems>
            <field>Case.AccountManager__c</field>
            <operation>notEqual</operation>
        </criteriaItems>
        <triggerType>onCreateOrTriggeringUpdate</triggerType>
    </rules>
</Workflow>
