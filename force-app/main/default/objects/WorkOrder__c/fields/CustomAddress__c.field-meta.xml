<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>CustomAddress__c</fullName>
    <description>Determines if the Work Order should show the Account shipping address or the address as entered on the Quote</description>
    <externalId>false</externalId>
    <formula>(ISPICKVAL(Order__r.Opportunity.Sub_Type__c, &apos;Loan&apos;) || ISPICKVAL(Order__r.Opportunity.Sub_Type__c, &apos;Show&apos;)) &amp;&amp; (Account__r.ShippingStreet &lt;&gt; Order__r.SBQQ__Quote__r.SBQQ__ShippingStreet__c) &amp;&amp; NOT(ISBLANK(Order__r.SBQQ__Quote__r.SBQQ__ShippingStreet__c))</formula>
    <label>Custom Address</label>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Checkbox</type>
</CustomField>
