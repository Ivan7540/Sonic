<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Stock__c</fullName>
    <deleteConstraint>SetNull</deleteConstraint>
    <description>Looks up to the Stock record. Used in swap outs to replace the current Stock record (deprecated) on an existing Asset that is related to another Work Order Line Item.</description>
    <externalId>false</externalId>
    <label>Stock</label>
    <lookupFilter>
        <active>true</active>
        <booleanFilter>1 OR 2</booleanFilter>
        <filterItems>
            <field>Stock__c.Status__c</field>
            <operation>equals</operation>
            <value>In Stock</value>
        </filterItems>
        <filterItems>
            <field>Stock__c.Status__c</field>
            <operation>equals</operation>
            <value>Boot stock</value>
        </filterItems>
        <infoMessage>Stock must be in &apos;In Stock&apos; status</infoMessage>
        <isOptional>true</isOptional>
    </lookupFilter>
    <referenceTo>Stock__c</referenceTo>
    <relationshipLabel>Work Order Line Items</relationshipLabel>
    <relationshipName>WorkOrderLineItems</relationshipName>
    <required>false</required>
    <trackFeedHistory>false</trackFeedHistory>
    <trackTrending>false</trackTrending>
    <type>Lookup</type>
</CustomField>
