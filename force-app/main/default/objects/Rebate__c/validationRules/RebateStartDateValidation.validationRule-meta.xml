<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>RebateStartDateValidation</fullName>
    <active>false</active>
    <errorConditionFormula>SubscriptionStartDate__c &gt;  StartDate__c</errorConditionFormula>
    <errorDisplayField>StartDate__c</errorDisplayField>
    <errorMessage>Rebate Start Date cannot be before Subscription Start Date</errorMessage>
</ValidationRule>
