<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Switchpay_Cannot_be_less_than_Masterpass</fullName>
    <active>true</active>
    <errorConditionFormula>BLANKVALUE(SwitchpayQuantity__c, 0)  &gt;  BLANKVALUE(MasterpassQuantity__c, 0)</errorConditionFormula>
    <errorMessage>Switchpay quantity cannot be more than Masterpass quantity. Please make Masterpass quantity at least same as Switchpay</errorMessage>
</ValidationRule>
